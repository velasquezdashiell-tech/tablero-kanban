{
  "name": "tablero-kanban",
  "version": "0.1.0",
  "description": "Proyecto de Lenguaje de Programación · cambia este texto por la descripción de tu producto",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env src/app/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/app/server.ts",
    "migrate": "node --env-file-if-exists=.env db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env db/migrate.ts --reset",
    "seed": "node --env-file-if-exists=.env db/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "bench": "node src/shared/algorithms/benchmark.ts",
    "backlog": "node scripts/crear-backlog.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}